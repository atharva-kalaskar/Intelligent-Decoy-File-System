logs/*.jsonl
logs/*.log
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/test_results/*
!data/test_results/.gitkeep

# SQLite database
*.sqlite3
*.db
application/*.db

# OS Artifacts
Thumbs.db
Desktop.ini
.DS_Store
